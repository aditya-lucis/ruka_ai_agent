{
  "name": "ruka-desktop",
  "version": "0.3.7",
  "description": "RUKA — The Persistent Mind & Companion Desktop Body",
  "main": "out/electron/main.js",
  "scripts": {
    "build:ts": "tsc",
    "build:renderer": "vite build",
    "build": "tsc && vite build",
    "start": "tsc && vite build && electron .",
    "dev": "tsc -w",
    "pack": "npm run build && electron-builder --dir",
    "dist": "node scripts/build-dist.js"
  },
  "build": {
    "appId": "trendamis.ruka.persistentmind",
    "productName": "Ruka",
    "compression": "normal",
    "directories": {
      "output": "release"
    },
    "files": [
      "out/**/*",
      "assets/**/*",
      "!**/*.map"
    ],
    "extraResources": [
      {
        "from": "resources/brain",
        "to": "brain",
        "filter": [
          "**/*"
        ]
      },
      {
        "from": "resources/kernel",
        "to": "kernel",
        "filter": [
          "**/*"
        ]
      }
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "assets/icon.png"
    },
    "nsis": {
      "differentialPackage": false,
      "include": "../installer/installer.nsh",
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "deleteAppDataOnUninstall": false,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Ruka",
      "runAfterFinish": true,
      "installerLanguages": [
        "id-ID",
        "en-US"
      ]
    }
  },
  "keywords": [
    "ruka",
    "companion",
    "ai-agent",
    "electron",
    "desktop"
  ],
  "author": "Aditya & Ruka Team",
  "license": "MIT",
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^22.10.2",
    "@types/three": "^0.186.0",
    "@vitejs/plugin-vue": "^6.0.9",
    "electron": "^33.2.1",
    "electron-builder": "^25.1.8",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.7.2",
    "vite": "^8.3.4"
  },
  "dependencies": {
    "three": "^0.186.1",
    "vue": "^3.5.43"
  }
}

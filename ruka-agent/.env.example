# ---- Google Gemini API ----
# Dapatkan dari https://aistudio.google.com/apikey — JANGAN pernah commit .env
GEMINI_API_KEY=
# ---- Model (default: frontier flash untuk agent jangka panjang) ----
RUKA_MODEL=gemini-3.8-flash
# ---- Lingkungan eksekusi ----
# development | staging | production
RUKA_ENVIRONMENT=development
# ---- Voice (AKT IV; boleh dikosongkan sampai PART 12) ----
RUKA_TTS_MODEL=gemini-3.1-flash-tts-preview
RUKA_VOICE=Sulafat
# ---- Live (AKT IV, patch 1.1: dipisah agar bisa diatur terpisah) ----
RUKA_LIVE_MODEL=gemini-3.1-flash-live-preview
# ---- Opsional: batas debug ----
RUKA_MAX_ITERATIONS=12
RUKA_TOKEN_BUDGET=60000
